<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Canvas Basketball Game</title>
</head>
<body>
  <canvas id="ballArea" width="1270" height="800" style="background:#eee;"></canvas>
  <script>
    "use strict";
    const canvas = document.getElementById('ballArea');
    const ctx = canvas.getContext('2d');

    // Simple ball and hoop representation
    let ball = { x: 100, y: 650, r: 20, vx: 10, vy: -15, active: false };
    let hoop = { x: 1150, y: 250, w: 60, h: 10 };
    let score = 0;

    canvas.addEventListener('click', () => {
      ball.x = 100;
      ball.y = 650;
      ball.vx = 14;
      ball.vy = -18;
      ball.active = true;
    });

    function update() {
      if (ball.active) {
        ball.x += ball.vx;
        ball.y += ball.vy;
        ball.vy += 0.8; // gravity

        // Check score collision
        if (
          ball.x > hoop.x && ball.x < hoop.x + hoop.w &&
          ball.y > hoop.y && ball.y < hoop.y + hoop.h
        ) {
          score++;
          ball.active = false;
        }

        // Reset if out of bounds
        if (ball.y > canvas.height || ball.x > canvas.width) {
          ball.active = false;
        }
      }
    }

    function draw() {
      ctx.clearRect(0, 0, canvas.width, canvas.height);

      // Draw hoop
      ctx.fillStyle = 'orange';
      ctx.fillRect(hoop.x, hoop.y, hoop.w, hoop.h);

      // Draw ball
      ctx.beginPath();
      ctx.arc(ball.x, ball.y, ball.r, 0, Math.PI * 2);
      ctx.fillStyle = 'brown';
      ctx.fill();
      ctx.closePath();

      // Draw score
      ctx.fillStyle = 'black';
      ctx.font = '24px Arial';
      ctx.fillText('Score: ' + score, 30, 50);
      ctx.fillText('Click anywhere to shoot!', 30, 80);
    }

    function loop() {
      update();
      draw();
      requestAnimationFrame(loop);
    }

    loop();
  </script>
</body>
</html>
